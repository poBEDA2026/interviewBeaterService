# Database Configuration
POSTGRES_DB=interviewbeater
POSTGRES_USER=interviewbeater
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# MinIO (S3 Storage) Configuration
# Официальный образ quay.io/minio недоступен через корпоративный прокси — используется зеркало ghcr.io
MINIO_IMAGE=ghcr.io/coollabsio/minio:latest
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Application Configuration
APP_PORT=8080

# JWT Configuration (CHANGE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Spring Profiles
SPRING_PROFILES_ACTIVE=docker

# Logging Configuration
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_WEB=INFO
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_SQL=INFO
DB_SHOW_SQL=false
