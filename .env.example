# Database Configuration
POSTGRES_DB=interviewbeater
POSTGRES_USER=interviewbeater
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Application Configuration
APP_PORT=8080

# JWT Configuration (CHANGE IN PRODUCTION!)
# ttl format: ISO-8601 Duration (e.g. PT1H = 1 hour, PT168H = 7 days)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_TTL=PT1H
JWT_REFRESH_TTL=PT168H

# Spring Profiles
SPRING_PROFILES_ACTIVE=docker

# Logging Configuration
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_WEB=INFO
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_SQL=INFO
DB_SHOW_SQL=false
